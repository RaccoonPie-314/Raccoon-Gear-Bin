  "expectations": {
    "_comment": "What the synthetic data must produce, asserted independently of the fixtures so a bad fixture edit fails loudly instead of silently changing the test.",
    "cards": 6,
    "priceLowToHigh": ["39.00", "45.00", "59.00", "89.00", "123.45", "149.00"],
    "stockSequence": ["in", "low", "out", "in", "in", "low"],
    "conversion": {
      "_comment": "The Phase 1 customer-facing contract, stated here so a message line, a CTA label or a channel list can only be changed deliberately. The strings are the English values of the keys in i18n.config.ts and the hrefs are built from the site_settings row above; the harness compares what the app actually produced against this, so drifting one side fails loudly instead of quietly re-wording the flow. `lines` is the composition policy itself: five lines, in this order.",
      "cta": { "in": "Contact to order", "low": "Contact to order", "out": "Ask about availability" },
      "ask": {
        "in": "Is it available? I would like to order one.",
        "low": "Stock looks low — can I still order one?",
        "out": "I can see it is out of stock. Could you let me know when it can be restocked?"
      },
      "bands": { "in": "In Stock", "low": "Low Stock", "out": "Out of Stock" },
      "lines": ["I am interested in {name}.", "Price: {currency} {price}", "SKU: {sku}", "{ask}", "{url}"],
      "feedback": {
        "copied": "Message copied.",
        "blocked": "Your browser blocked the copy — copy the link yourself.",
        "link": "Product link copied."
      },
      "appName": "Raccoon Gear Bin",
      "titleSuffix": " | Raccoon Gear Bin",
      "_comment_channels": "The contact list the product page must offer for the seeded row set, in stored order, after the phone. It is a three-case probe: facebook is `enabled` but not `contact_enabled` (visible in the header, unusable to order), telegram carries no `contact_enabled` at all (an old row, which must inherit `enabled` and stay contactable), and tiktok is hidden from the header but explicitly contactable. `{message}` is filled in by the check with the encodeURIComponent of that product's own prepared message — only the two platforms with a documented prefill carry it, and tiktok's href must stay byte-for-byte the stored URL.",
      "channelLabels": ["Phone", "Telegram", "Tiktok"],
      "channelHrefs": ["tel:+85512345678", "https://t.me/raccoongearbin?text={message}", "https://tiktok.com/@raccoongearbin.hidden"],
      "channelsPrefilled": [false, true, false],
      "claimPrefilled": "Opens with your message",
      "claimCopy": "Copy, then paste",
      "_comment_saved": "After the admin flow disables telegram, adds youtube, enables tiktok, reorders and removes facebook: the header shows youtube+tiktok, while the contact list keeps telegram (still `contact_enabled`) and gains tiktok. The two lists are allowed to differ — that difference is the feature.",
      "savedChannelLabels": ["Phone", "telegram", "youtube", "tiktok"],
      "savedChannelHrefs": ["tel:+85599888777", "https://t.me/raccoongearbin?text={message}", "https://youtube.com/@raccoongearbin", "https://tiktok.com/@raccoongearbin.hidden"],
      "sticky": { "controlHeight": 44, "minPadding": 12, "lightboxZ": 70 }
    },
    "share": {
      "_comment": "The Share Sheet contract, stated here so the sheet's words and its destination list can only change deliberately. `label` is the English value of `shareSheetLabel`. `{share}` is filled by the check with the encodeURIComponent of the share text — the product's name, its own summary line, then the canonical URL, one per line (`lines`). The list is the shop's *visible* header links (facebook, telegram) and deliberately NOT its contact list (telegram, tiktok): the two settings answer different questions, so a sheet that borrowed the other's filter fails on membership alone. Only Telegram documents a prefill, so facebook's href must stay byte-for-byte the stored URL.",
      "label": "Share {name}",
      "viaLabel": "Share via",
      "copyLink": "Copy link",
      "copyMessage": "Copy message",
      "lines": ["{name}", "{short}", "{url}"],
      "destinationPlatforms": ["facebook", "telegram"],
      "destinationHrefs": ["https://facebook.com/raccoongearbin", "https://t.me/raccoongearbin?text={share}"],
      "destinationsPrefilled": [false, true]
    },
    "stockBands": {
      "_comment": "The fixture quantities are 7, 3, 0, 12, 25, 4 against LOW_STOCK_THRESHOLD 5, so all three bands appear twice and the boundary is tested on both sides (4 and 5 would be low, 7 is not). The band now comes from app/utils/product-stock.ts instead of being re-derived inside the badge, so the check asserts the band, its label and its colour together — that is what proves the shared rule did not move a threshold or a class.",
      "in": { "label": "In Stock", "text": "text-zinc-400", "dot": "bg-zinc-400" },
      "low": { "label": "Low Stock", "text": "text-zinc-500", "dot": "bg-zinc-500" },
      "out": { "label": "Out of Stock", "text": "text-zinc-950", "dot": "bg-zinc-950" }
    },
    "specRows": {
      "aaaaaaaa-0000-4000-8000-000000000001": [["Switch", "MX Red"], ["Ratio", "60:40"], ["Weight", "58g"]],
      "aaaaaaaa-0000-4000-8000-000000000002": [["Sensor", "PixArt 3395"], ["DPI", "26000"]],
      "aaaaaaaa-0000-4000-8000-000000000003": [["Battery", "40h"], ["Codec", "LC3"]]
    },
    "sortedPayloadColumns": "category_id,price,sku,slug,status,stock_quantity",
