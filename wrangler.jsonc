// Cloudflare Workers. `bun run deploy` builds the Nitro output this points at and uploads it.
// The free plan is enough: 1.9 MB bundle (limit 64 MiB), 55 assets (limit 20k), 100k req/day.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "raccoon-gear-bin",
  // ESM Worker entry with a `fetch` export — nitro's `cloudflare_module` preset, not the legacy
  // service-worker one. It reads static files through the ASSETS binding below.
  "main": ".output/server/index.mjs",
  // Same date nuxt.config.ts declares, so nitro and the runtime agree on it.
  "compatibility_date": "2025-07-15",
  // supabase-js pulls in a few Node builtins through nitro's unenv shim layer. Nitro also reads
  // this flag before bundling, which is why the config lives in the repo instead of being
  // generated by `wrangler deploy`.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
