NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# No SUPABASE_SERVICE_ROLE_KEY on purpose: `supabase.secretKey` is pinned to '' in nuxt.config.ts,
# and server runtime config is inlined into the uploaded bundle — the pin is what keeps it out.
NUXT_TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
NUXT_TELEGRAM_BOT_TOKEN=bot-token-from-botfather
NUXT_TELEGRAM_CHAT_ID=destination-chat-id-for-order-pushes
# The migrator scripts read DATABASE_URL; the Worker runtime reads NUXT_DATABASE_URL (same value).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
NUXT_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NUXT_CLERK_SECRET_KEY=sk_test_...
NUXT_PAYWAY_MERCHANT_ID=merchant-id-from-payway
NUXT_PAYWAY_API_KEY=api-key-from-payway
# Production default is https://checkout.payway.com.kh; point this at the sandbox host while testing.
NUXT_PAYWAY_BASE=https://checkout-sandbox.payway.com.kh
